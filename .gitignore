# AegisAPI Root .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env

# SQLite Databases & Storage
*.db
*.sqlite
*.sqlite3
backend/*.db
backend/*.sqlite3

# ML Models & Checkpoints (Keep directory via .gitkeep)
models/*
!models/.gitkeep

# Datasets (Keep directory via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Jupyter Notebooks
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Testing & Coverage
.coverage
.coverage.*
.pytest_cache/
htmlcov/
nosetests.xml
coverage.xml
*.cover

# Node.js & React Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/*.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System
.DS_Store
Thumbs.db
Desktop.ini

